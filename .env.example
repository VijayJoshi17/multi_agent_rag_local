# ---------------------------------------------------------------------------
# Copy to `.env` (repo root for Docker, or backend/.env for local dev).
# ---------------------------------------------------------------------------

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- LLM: any OpenAI-compatible endpoint ---------------------------------
# OpenRouter (default). Free models end in ":free" — see https://openrouter.ai/models?max_price=0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Free models change often; LLM_MODEL=openrouter/free picks any available one. See README.

# Fully local alternative (Ollama):
# LLM_BASE_URL=http://localhost:11434/v1      # or http://ollama:11434/v1 inside Docker
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# --- Optional tuning --------------------------------------------------------
# LOG_LEVEL=INFO
# RERANKER_ENABLED=true
# MAX_VERIFY_RETRIES=1
# MAX_UPLOAD_MB=25
# RATE_LIMIT_CHAT=20/minute
# HTTP_PORT=8080
